generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String            @id @default(cuid())
  email        String            @unique
  name         String?
  passwordHash String?
  image        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  favorites    Favorite[]
  submissions  SkillSubmission[]
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  skillSlug String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillSlug])
  @@index([userId])
}

model SkillSubmission {
  id          String   @id @default(cuid())
  userId      String
  title       String
  tagline     String
  description String
  category    String
  price       Int      @default(0)
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}